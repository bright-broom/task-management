# ============================================================================
# M2X Task Management - 環境変数設定ファイル
# ============================================================================
#
# 使用方法:
# 1. このファイルを .env にコピー: cp .env.example .env
# 2. 各値を本番環境に適した値に設定
# 3. .env ファイルは絶対にGitにコミットしないこと
#
# セキュリティ要件:
# - 本番環境では必ず強力なパスワード/シークレットを設定
# - シークレットは32文字以上のランダム文字列を推奨
# - 定期的にシークレットをローテーション
#
# ============================================================================

# ============================================================================
# データベース設定
# ============================================================================

# PostgreSQL接続URL
# 形式: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://m2x_user:CHANGE_ME_STRONG_PASSWORD@db:5432/m2x_task_management

# PostgreSQL認証情報（Docker用）
POSTGRES_USER=m2x_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=m2x_task_management

# ============================================================================
# アプリケーション設定
# ============================================================================

# Flaskシークレットキー（セッション暗号化用）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET

# デバッグモード（本番環境では必ずfalse）
FLASK_DEBUG=false

# ホスト設定
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================================
# JWT認証設定
# ============================================================================

# JWTシークレットキー（トークン署名用）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET

# トークン有効期限（秒）
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# ============================================================================
# セキュリティ設定
# ============================================================================

# CORS許可オリジン（カンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# HSTS有効化（HTTPSを使用する本番環境のみ）
ENABLE_HSTS=false

# セキュリティDBログ有効化
SECURITY_DB_LOGGING=false

# ============================================================================
# コネクションプール設定
# ============================================================================

POOL_MIN_CONNECTIONS=2
POOL_MAX_CONNECTIONS=20

# ============================================================================
# レート制限設定
# ============================================================================

# デフォルトレート制限（リクエスト/分）
RATE_LIMIT_DEFAULT=60

# 認証エンドポイントレート制限
RATE_LIMIT_AUTH=10

# ============================================================================
# ログ設定
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
